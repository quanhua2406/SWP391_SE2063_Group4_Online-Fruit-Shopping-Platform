<%@page pageEncoding="UTF-8"%>
<!-- Grouped navigation: every stock function is its own small page -->

<nav class="section-nav">

    <a class="<%= "stock".equals(activePage) ? "active" : "" %>"
       href="<%= contextPath %>/store-owner/inventory">
        📦 Xem tồn kho
    </a>

    <a class="<%= "update".equals(activePage) ? "active" : "" %>"
       href="<%= contextPath %>/store-owner/inventory/update">
        ✏️ Cập nhật tồn
    </a>

    <a class="<%= "restock".equals(activePage) ? "active" : "" %>"
       href="<%= contextPath %>/store-owner/inventory/restock">
        📥 Nhập hàng
    </a>

    <a class="<%= "lowstock".equals(activePage) ? "active" : "" %>"
       href="<%= contextPath %>/store-owner/inventory/low-stock">
        ⚠️ Sắp hết hàng
    </a>

    <a class="<%= "expired".equals(activePage) ? "active" : "" %>"
       href="<%= contextPath %>/store-owner/inventory/expired">
        ⚠️ Không đảm bảo chất lượng
    </a>

    <a class="<%= "history".equals(activePage) ? "active" : "" %>"
       href="<%= contextPath %>/store-owner/inventory/history">
        🕓 Lịch sử
    </a>

</nav>
