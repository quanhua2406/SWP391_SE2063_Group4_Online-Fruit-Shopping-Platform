<%@page pageEncoding="UTF-8"%>
<%@page import="java.util.List"%>
<%@page import="java.util.Map"%>
<%@page import="java.math.BigDecimal"%>
<%@page import="java.util.Locale"%>
<%@page import="com.mycompany.onlinefruitshopping.utils.Page"%>
<%@page import="com.mycompany.onlinefruitshopping.utils.Pager"%>
<%@page import="com.mycompany.onlinefruitshopping.utils.QueryUrl"%>
<%@page import="com.mycompany.onlinefruitshopping.utils.VariantWeights"%>

<%!
    private String esc(Object value) {
        if (value == null) {
            return "";
        }

        return value.toString()
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;")
                .replace("'", "&#39;");
    }

    private String qty(Object value) {
        if (value == null) {
            return "0";
        }

        BigDecimal number = value instanceof BigDecimal
                ? (BigDecimal) value
                : new BigDecimal(value.toString());

        return number.stripTrailingZeros().toPlainString();
    }

    private String money(Object value) {
        if (value == null) {
            return "0 \u0111";
        }

        BigDecimal number = value instanceof BigDecimal
                ? (BigDecimal) value
                : new BigDecimal(value.toString());

        return String.format(Locale.US, "%,.0f", number) + " \u0111";
    }

    private String date(Object value) {
        return value == null ? "-" : value.toString();
    }

    private String typeLabel(Object value) {
        if (value == null) {
            return "";
        }

        String type = value.toString().toLowerCase();

        switch (type) {
            case "import":
                return "Nhập hàng";
            case "export":
                return "Xuất kho";
            case "discard":
                return "Hủy hàng";
            default:
                return value.toString();
        }
    }

    private String typePill(Object value) {
        if (value == null) {
            return "pill-ok";
        }

        String type = value.toString().toLowerCase();

        switch (type) {
            case "export":
                return "pill-warn";
            case "discard":
                return "pill-danger";
            default:
                return "pill-ok";
        }
    }
%>

<%
    String contextPath = request.getContextPath();

    String shopName = request.getAttribute("shopName") == null
            ? ""
            : request.getAttribute("shopName").toString();

    Object threshold = request.getAttribute("threshold");
    String thresholdText = threshold == null ? "0" : threshold.toString();

    String message = request.getAttribute("message") == null
            ? ""
            : request.getAttribute("message").toString();

    String level = "success-message";
    String messageText = null;

    if ("restocked".equals(message)) {
        messageText = "Đã nhập hàng thành công.";
    } else if ("updated".equals(message)) {
        messageText = "Đã cập nhật số lượng tồn kho.";
    } else if ("threshold-saved".equals(message)) {
        messageText = "Đã cập nhật ngưỡng tồn kho thấp.";
    } else if ("notified".equals(message)) {
        messageText = "Đã gửi email cảnh báo tồn kho thấp tới địa chỉ tài khoản của bạn.";
    } else if ("notify-none".equals(message)) {
        messageText = "Không có sản phẩm nào dưới ngưỡng an toàn - không gửi cảnh báo.";
    } else if ("notify-failed".equals(message)) {
        level = "error-message";
        messageText = "Không thể gửi email cảnh báo. Vui lòng thử lại sau.";
    } else if ("duplicate".equals(message)) {
        level = "error-message";
        messageText = "Mã lô này đã tồn tại cho biến thể đó.";
    } else if ("expired".equals(message)) {
        level = "error-message";
        messageText = "Ngày hết hạn không được nằm trong quá khứ.";
    } else if ("invalid".equals(message)) {
        level = "error-message";
        messageText = "Vui lòng nhập thông tin tồn kho hợp lệ.";
    } else if ("forbidden".equals(message)) {
        level = "error-message";
        messageText = "Bạn không có quyền thay đổi mục này.";
    } else if ("requested".equals(message)) {
        messageText = "Đã gửi yêu cầu bỏ lô. Chủ shop cần duyệt để bỏ khỏi tồn kho.";
    } else if ("already-requested".equals(message)) {
        level = "error-message";
        messageText = "Lô này đã có yêu cầu bỏ hàng đang chờ duyệt.";
    } else if ("approved".equals(message)) {
        messageText = "Đã duyệt và bỏ lô không đảm bảo chất lượng khỏi tồn kho.";
    } else if ("rejected".equals(message)) {
        messageText = "Đã từ chối yêu cầu bỏ hàng. Lô được giữ nguyên.";
    } else if ("already-resolved".equals(message)) {
        level = "error-message";
        messageText = "Yêu cầu này đã được xử lý trước đó.";
    } else if ("not-expired".equals(message)) {
        level = "error-message";
        messageText = "Lô này chưa hết hạn nên không thể bỏ.";
    } else if ("already-discarded".equals(message)) {
        level = "error-message";
        messageText = "Lô này đã được bỏ trước đó.";
    } else if ("discarded".equals(message)) {
        messageText = "Đã bỏ lô không đảm bảo chất lượng khỏi tồn kho.";
    } else if ("quality-discarded".equals(message)) {
        messageText = "Đã bỏ hàng không đạt chất lượng và trừ khỏi tồn kho.";
    } else if ("not-active".equals(message)) {
        level = "error-message";
        messageText = "Lô này không còn hàng đang bán nên không thể bỏ thêm.";
    } else if ("insufficient".equals(message)) {
        level = "error-message";
        messageText = "Số lượng bỏ lớn hơn số lượng còn trong lô.";
    } else if ("failed".equals(message)) {
        level = "error-message";
        messageText = "Không thể hoàn tất thao tác.";
    }
%>

